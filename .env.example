
APP_PORT=3000
APP_NAME=CodeCircle
NODE_ENV=development

# Database 
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=project_db
DB_SYNCHRONIZE=false

# JWT
